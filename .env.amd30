# .env.amd30 — environment overrides for 10.0.0.30 (Strix Halo, AMD Ryzen AI MAX+ 395)
# APU (GFX1151, KHR_coopmat) is device 1 on this machine — preferred over RX 6600 XT
#
# Usage (from /home/matthewh/audio.cpp-hub):
#   docker compose -f compose.amd.yaml --env-file .env.amd30 up -d --build

# Network: bridge mode on standalone host
NETWORK_MODE=bridge

# GPU: Strix Halo APU — Vulkan:1 (RTF ~0.94x, matrix cores enabled)
AUDIOCPP_DEVICE=1
AUDIOCPP_THREADS=8

# Model: Breeze TTS 2
AUDIOCPP_MODEL_ID=breeze-tts
AUDIOCPP_SERVICE_NAME=breeze
AUDIOCPP_WEIGHTS=/audio.cpp/models/breeze-tts-2-q8_0.gguf

WARMUP_TEXT=This is a warm-up sentence for audio generation.

# Host paths for volume mounts
HOST_AUDIOCPP_BIN=/home/matthewh/audio.cpp/bin-gtx
HOST_AUDIOCPP_WEIGHTS=/home/matthewh/audio.cpp/breeze/breeze-tts-2-q8_0.gguf

# GPU group GIDs on 10.0.0.30
GPU_GID_VIDEO=44
GPU_GID_RENDER=993

