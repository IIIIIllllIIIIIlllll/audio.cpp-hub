# .env.lxc100 — environment overrides for LXC container 100 (10.0.0.100)
# AMD RX 6600 XT (Navi23), device 0, PocketTTS model
#
# Usage:
#   docker compose -f compose.amd.yaml --env-file .env.lxc100 up -d --build

# GPU: RX 6600 XT is the only GPU in this LXC, always device 0
AUDIOCPP_DEVICE=0
AUDIOCPP_THREADS=4

# Model: PocketTTS (already downloaded)
AUDIOCPP_MODEL_ID=pocket-tts
AUDIOCPP_SERVICE_NAME=pocket
AUDIOCPP_WEIGHTS=/audio.cpp/models/pocket-tts-english-q8_0.gguf

WARMUP_TEXT=Hello, this is the audio system starting up.

# Host paths for volume mounts
HOST_AUDIOCPP_SERVER=/root/audio.cpp-hub/audiocpp_bin/audiocpp_server
HOST_AUDIOCPP_WEIGHTS=/root/audio.cpp/models/PocketTTS-GGUF/english/pocket-tts-english-q8_0.gguf
